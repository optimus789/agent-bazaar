# ── LLM ─────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=                 # or leave empty and set LLM_BASE_URL for an OpenAI-compatible server
LLM_MODEL=claude-sonnet-5          # e.g. qwen2.5-7b-instruct when using LM Studio
LLM_BASE_URL=                      # e.g. http://localhost:1234/v1

# ── The Graph ───────────────────────────────────────────────────────────────
GRAPH_API_KEY=                     # Subgraph Studio API key (Studio path)
X402_ENV=testnet                   # testnet → pays on base-sepolia; production → pays on base
EVM_BUYER_PRIVATE_KEY=0x           # Base Sepolia: pays Graph x402 queries, gives ERC-8004 feedback
EVM_PROVIDER_PRIVATE_KEY=0x        # Base Sepolia + Hedera EVM: owns provider ERC-8004 identities

# ── Hedera testnet (ECDSA accounts from portal.hedera.com) ──────────────────
HEDERA_BUYER_ACCOUNT_ID=0.0.
HEDERA_BUYER_PRIVATE_KEY=0x
HEDERA_PROVIDER_ACCOUNT_ID=0.0.
HEDERA_PROVIDER_PRIVATE_KEY=0x
X402_TESTNET_FACILITATOR_URL=https://api.testnet.blocky402.com   # prize requires Blocky402
HCS_RECEIPT_TOPIC_ID=              # created on first provider boot if empty

# ── Arc testnet ─────────────────────────────────────────────────────────────
ARC_NETWORK=testnet
ARC_SELLER_ADDRESS=0x
ARC_SELLER_PRIVATE_KEY=0x
ARC_BUYER_PRIVATE_KEY=0x
SELLER_ADMIN_TOKEN=change-me

# ── Runtime ────────────────────────────────────────────────────────────────
MOCK=0                             # 1 = no network calls, fixtures only
PROVIDER_HEDERA_PORT=4021
PROVIDER_ARC_PORT=4022
DASHBOARD_PORT=3000

# ── Dashboard (apps/dashboard) ───────────────────────────────────────────────
# GRAPH_API_KEY, MOCK and SELLER_ADMIN_TOKEN above are reused as-is.
PROVIDER_HEDERA_URL=http://localhost:4021
PROVIDER_ARC_URL=http://localhost:4022
